  "scenarios": [
    {
      "name": "machine_path_fires_without_banning",
      "args": {
        "emit_suspects": true,
        "detector_config": {"machine_path_patterns": ["(?:^|/)robots\\.txt$"]}
      },
      "actors": {
        "source": {"ip": "doc:2:20", "ua": "chrome_win_135", "referer": "referrer"}
      },
      "events": [
        {"actor": "source", "at": 0, "path": "/synthetic/robots.txt", "status": "404"}
      ],
      "expect": {
        "batch": {
          "bots": ["source"],
          "proofs": {"source": ["machine-path"]},
          "actions": {"source": "suspect"},
          "max_action": {"source": "suspect"}
        },
        "live": {
          "emission_count": 1,
          "emissions": [
            {"actor": "source", "action": "suspect", "reasons": ["machine-path"]}
          ],
          "forbidden_actions": {"source": ["ban"]}
        }
      }
    },
